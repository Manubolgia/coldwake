{
  "name": "coldwake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "COLDWAKE — a single-player, offline-first space horror board game as a PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "sim": "tsx src/sim/cli.ts",
    "play:random": "tsx src/sim/play.ts",
    "gate:m0": "tsx scripts/gate.ts m0",
    "gate:m1": "tsx scripts/gate.ts m1",
    "gate:m2": "tsx scripts/gate.ts m2",
    "gate:m3": "tsx scripts/gate.ts m3",
    "gate:m4": "tsx scripts/gate.ts m4",
    "gate:m5": "tsx scripts/gate.ts m5",
    "gate:m6": "tsx scripts/gate.ts m6",
    "golden:regen": "tsx scripts/regen-golden.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "idb-keyval": "^6.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4",
    "zod": "^4.0.0"
  }
}
